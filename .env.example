# SMTP relay used to send email-verification codes (server/mailer.mjs).
# Point these at your own mail server or provider's SMTP — no 3rd-party email
# API/account required. Copy this file to .env and fill in real values.
SMTP_HOST=mail.example.com
SMTP_PORT=587
# "true" for implicit TLS (typically port 465), "false" for STARTTLS (typically 587)
SMTP_SECURE=false
# Leave SMTP_USER/SMTP_PASS blank if your relay allows unauthenticated local submission.
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Agent Syndicate <no-reply@example.com>"
# Only set to "false" for a throwaway local test relay with a self-signed cert.
# See docs/postfix-security.md #7 — never disable this against a real relay.
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Signs the returning-player session cookie (server/session.mjs) so it can't be
# forged. Required for sessions to survive a server restart. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# For local testing only, when you have no SMTP relay yet: leave SMTP_HOST blank
# above and set this to "true" to print codes to the terminal instead of
# emailing them. Never set this in production.
SMTP_CONSOLE_FALLBACK=false

# How much the email gate asks for. Read by BOTH the build (vite.config.js bakes
# it into the bundle) and the server, so rebuild after changing it — a restart
# alone is not enough. See server/gateLevel.mjs.
#
#   0  Off. No gate, no dashboard: players go straight to the game, and
#      /admin.html is left out of the build so its URL 404s rather than serving a
#      login no API can answer. Needs no server at all — the static-deploy default.
#   1  Collect. The form saves the address the moment it is submitted. No SMTP
#      required, so addresses are UNVERIFIED — anyone can type anyone's address.
#   2  Verify. The form emails a 6-digit code and saves only once it matches.
#      Requires working SMTP_* settings above; without them nobody can get in.
#
# Levels 1 and 2 also need SESSION_SECRET and ADMIN_PASSWORD set, and the Node
# server running to answer /api/*. Anything unset or unrecognized means 0.
EMAIL_GATE_LEVEL=0

# Password for the admin dashboard at /admin.html (toggle the email gate,
# download data/emails.jsonl as CSV). Required to log in — pick a strong,
# unique value; it's compared with a timing-safe check, not hashed.
ADMIN_PASSWORD=


# Postgres connection string. Set it and the email gate stores addresses, the
# admin toggle and level 2's pending codes in Postgres instead of data/*.jsonl —
# required on any host with a read-only filesystem, which includes Vercel's
# serverless functions. Leave it BLANK for local runs: `npm run dev` and
# `npm start` then use the data files and need no database at all.
#
# On Vercel this is injected automatically by the Neon marketplace integration;
# don't set it by hand there. See docs/vercel-deployment.md.
DATABASE_URL=
