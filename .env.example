# SMTP relay used to send email-verification codes (server/mailer.mjs).
# Point these at your own mail server or provider's SMTP — no 3rd-party email
# API/account required. Copy this file to .env and fill in real values.
SMTP_HOST=mail.example.com
SMTP_PORT=587
# "true" for implicit TLS (typically port 465), "false" for STARTTLS (typically 587)
SMTP_SECURE=false
# Leave SMTP_USER/SMTP_PASS blank if your relay allows unauthenticated local submission.
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Agent Syndicate <no-reply@example.com>"
# Only set to "false" for a throwaway local test relay with a self-signed cert.
# See docs/postfix-security.md #7 — never disable this against a real relay.
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Signs the returning-player session cookie (server/session.mjs) so it can't be
# forged. Required for sessions to survive a server restart. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# For local testing only, when you have no SMTP relay yet: leave SMTP_HOST blank
# above and set this to "true" to print codes to the terminal instead of
# emailing them. Never set this in production.
SMTP_CONSOLE_FALLBACK=false

# Password for the admin dashboard at /admin.html (toggle the email gate,
# download data/emails.jsonl as CSV). Required to log in — pick a strong,
# unique value; it's compared with a timing-safe check, not hashed.
ADMIN_PASSWORD=

